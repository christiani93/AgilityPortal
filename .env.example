# AgilityPortal — Umgebungsvariablen
# Kopieren als .env und Werte eintragen

# Flask
SECRET_KEY=change-me-in-production

# Datenbank (Produktion: MySQL, lokal: SQLite wenn leer)
DATABASE_URL=mysql+pymysql://user:password@host/dbname

# API-Keys (Admin-Routen, AgilitySoftware-Sync)
ADMIN_KEY=change-me
LIVE_API_KEY=change-me
RESULTS_API_KEY=change-me

# Website-Sync: AgilityPortal → AdminPortal/z-b.tech
WEBSITE_API_URL=https://admin.z-b.tech
WEBSITE_API_TOKEN=change-me-match-adminportal
# Öffentliche URL des AgilityPortals (für Anmeldelink in body_md)
PORTAL_PUBLIC_URL=https://anmeldung.z-b.tech
