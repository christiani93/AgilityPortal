# AgilityPortal — Umgebungsvariablen
# Kopieren als .env und Werte eintragen

# Flask
SECRET_KEY=change-me-in-production

# Datenbank (Produktion: MySQL, lokal: SQLite wenn leer)
DATABASE_URL=mysql+pymysql://user:password@host/dbname

# API-Keys (Admin-Routen, AgilitySoftware-Sync)
ADMIN_KEY=change-me
LIVE_API_KEY=change-me
RESULTS_API_KEY=change-me
